# Google OAuth client ID (public; used by the browser). Create it in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Jira proxy (Vercel function): the only origin allowed to call /api/jira, e.g. https://taskuda.example.com
ALLOWED_ORIGIN=

# Search and AI visibility (build time). The public address, no trailing slash. On Vercel it falls
# back to the project's production domain, so this is only needed to override it.
SITE_URL=

# Leave empty to keep search engines and AI crawlers out (robots.txt "Disallow: /" and noindex).
# Set to "on" only when Taskuda is ready to be found publicly (security review waivers S1 and S3).
SITE_INDEXING=
